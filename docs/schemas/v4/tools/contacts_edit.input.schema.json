    },
    "jobTitle" : {
      "description" : "New job title.",
      "type" : "string"
    },
    "last" : {
      "description" : "New last name.",
      "type" : "string"
    },
    "organization" : {
      "description" : "New organization.",
      "type" : "string"
    },
    "phone" : {
      "description" : "New phone number.",
      "type" : "string"
    }
  },
  "required" : [
