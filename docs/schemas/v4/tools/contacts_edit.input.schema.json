{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "description" : "Edit an existing contact. Only the fields you pass are changed.",
  "properties" : {
    "confirmToken" : {
      "description" : "The confirmToken from a confirmation_required error, sent with the same arguments.",
      "type" : "string"
    },
    "dryRun" : {
      "default" : false,
      "description" : "Report what the call would do without doing it.",
      "type" : "boolean"
    },
    "email" : {
      "description" : "New email address.",
      "type" : "string"
    },
    "first" : {
      "description" : "New first name.",
      "type" : "string"
    },
    "idempotencyKey" : {
      "description" : "A repeat of this key and arguments within 24 hours replays the first result.",
      "type" : "string"
    },
    "identifier" : {
      "description" : "Contact identifier from contacts_search / contacts_show.",
      "type" : "string"
    },
    "jobTitle" : {
      "description" : "New job title.",
      "type" : "string"
    },
    "last" : {
      "description" : "New last name.",
      "type" : "string"
    },
    "organization" : {
      "description" : "New organization.",
      "type" : "string"
    },
    "phone" : {
      "description" : "New phone number.",
      "type" : "string"
    }
  },
  "required" : [
    "identifier"
  ],
  "title" : "contacts_edit: arguments",
  "type" : "object"
}
