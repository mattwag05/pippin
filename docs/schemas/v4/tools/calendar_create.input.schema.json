{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "description" : "Create a new calendar event.",
  "properties" : {
    "alert" : {
      "description" : "Alert before event (e.g. '15m', '1h', '2d').",
      "type" : "string"
    },
    "allDay" : {
      "default" : false,
      "description" : "Create as all-day event.",
      "type" : "boolean"
    },
    "calendar" : {
      "description" : "Calendar ID to create in.",
      "type" : "string"
    },
    "confirmToken" : {
      "description" : "Only after a confirmation_required error: the confirmToken it returned, with the same arguments, to carry out the call.",
      "type" : "string"
    },
    "dryRun" : {
      "default" : false,
      "description" : "Check the call and report what it would do, without doing it.",
      "type" : "boolean"
    },
    "end" : {
      "description" : "End date/time (default: start + 1 hour).",
      "type" : "string"
    },
    "idempotencyKey" : {
      "description" : "Optional. A repeat of this key with the same arguments within 24 hours returns the first result with replayed=true and does nothing.",
      "type" : "string"
    },
    "location" : {
      "description" : "Event location.",
      "type" : "string"
    },
    "notes" : {
      "description" : "Event notes.",
      "type" : "string"
    },
    "start" : {
      "description" : "Start date/time (YYYY-MM-DD or ISO 8601).",
      "type" : "string"
    },
    "title" : {
      "description" : "Event title.",
      "type" : "string"
    },
    "url" : {
      "description" : "Event URL.",
      "type" : "string"
    }
  },
  "required" : [
    "title",
    "start"
  ],
  "title" : "calendar_create: arguments",
  "type" : "object"
}
