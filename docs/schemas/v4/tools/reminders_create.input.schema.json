{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "description" : "Create a new reminder.",
  "properties" : {
    "confirmToken" : {
      "description" : "The confirmToken from a confirmation_required error, sent with the same arguments.",
      "type" : "string"
    },
    "dryRun" : {
      "default" : false,
      "description" : "Report what the call would do without doing it.",
      "type" : "boolean"
    },
    "due" : {
      "description" : "Due date/time (YYYY-MM-DD or ISO 8601).",
      "type" : "string"
    },
    "idempotencyKey" : {
      "description" : "A repeat of this key and arguments within 24 hours replays the first result.",
      "type" : "string"
    },
    "list" : {
      "description" : "Target list ID (default: default list).",
      "type" : "string"
    },
    "notes" : {
      "description" : "Reminder notes.",
      "type" : "string"
    },
    "priority" : {
      "description" : "Priority: high, medium, low, none.",
      "type" : "string"
    },
    "title" : {
      "description" : "Reminder title.",
      "type" : "string"
    },
    "url" : {
      "description" : "Reminder URL.",
      "type" : "string"
    }
  },
  "required" : [
    "title"
  ],
  "title" : "reminders_create: arguments",
  "type" : "object"
}
