{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "description" : "Copy Voice Memos recording(s) to a directory, optionally with transcript sidecars.",
  "properties" : {
    "all" : {
      "default" : false,
      "description" : "Export every recording.",
      "type" : "boolean"
    },
    "confirmToken" : {
      "description" : "The confirmToken from a confirmation_required error, sent with the same arguments.",
      "type" : "string"
    },
    "dryRun" : {
      "default" : false,
      "description" : "Report what the call would do without doing it.",
      "type" : "boolean"
    },
    "forceTranscribe" : {
      "default" : false,
      "description" : "Bypass transcript cache.",
      "type" : "boolean"
    },
    "id" : {
      "description" : "Memo UUID (omit with all=true).",
      "type" : "string"
    },
    "idempotencyKey" : {
      "description" : "A repeat of this key and arguments within 24 hours replays the first result.",
      "type" : "string"
    },
    "jobs" : {
      "default" : 2,
      "description" : "Parallel transcription jobs (default: 2).",
      "type" : "integer"
    },
    "output" : {
      "description" : "Destination directory (created if absent).",
      "type" : "string"
    },
    "sidecarFormat" : {
      "description" : "Sidecar format: txt (default), srt, markdown, rtf.",
      "type" : "string"
    },
    "transcribe" : {
      "default" : false,
      "description" : "Transcribe audio and write sidecar.",
      "type" : "boolean"
    }
  },
  "required" : [
    "output"
  ],
  "title" : "memos_export: arguments",
  "type" : "object"
}
