{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pippin agent envelope, version 4",
  "description": "The one JSON document every pippin command writes to stdout, and the text of every MCP tool result. New optional fields may appear in a minor release, so consumers must ignore fields they do not know.",
  "oneOf": [
    { "$ref": "#/$defs/ok" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "ok": {
      "type": "object",
      "required": ["v", "status", "duration_ms", "data"],
      "properties": {
        "v": { "const": 4 },
        "status": { "const": "ok" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "data": {
          "description": "The command's payload. Its shape per tool is in tools/<tool>.output.schema.json. An array stays an array under pagination."
        },
        "warnings": {
          "description": "Non-fatal advisories. Omitted when there are none.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "partial": {
          "description": "Present, and true, only when data is incomplete (a scan hit its soft timeout).",
          "const": true
        },
        "next_cursor": {
          "description": "Opaque token for the next page. Omitted on the last page.",
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["v", "status", "duration_ms", "error"],
      "properties": {
        "v": { "const": 4 },
        "status": { "const": "error" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "error": {
          "type": "object",
          "required": ["code", "message", "next_step"],
          "properties": {
            "code": {
              "description": "Stable machine-readable code.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "message": { "type": "string" },
            "next_step": {
              "type": "object",
              "required": ["retryable"],
              "properties": {
                "retryable": { "type": "boolean" },
                "retry_after_seconds": { "type": "integer", "minimum": 0 },
                "next_call": {
                  "type": "object",
                  "required": ["tool", "args", "argv"],
                  "properties": {
                    "tool": { "type": "string" },
                    "args": { "type": "object", "additionalProperties": { "type": "string" } },
                    "argv": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "human_action": { "type": "string" }
              }
            },
            "remediation": {
              "type": "object",
              "required": ["human_hint", "doctor_check"],
              "properties": {
                "human_hint": { "type": "string" },
                "doctor_check": { "type": "string" },
                "shell_command": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
